<?xml version="1.0"?>
<sdf version="1.11">
  <model name="arm">
    <link name="flange">
      <sensor name="ft" type="force_torque">
        <update_rate>500</update_rate>
        <force_torque>
          <frame>sensor</frame>
          <measure_direction>child_to_parent</measure_direction>
          <force>
            <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev><dynamic_bias_stddev>1.0</dynamic_bias_stddev><dynamic_bias_correlation_time>10</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev><dynamic_bias_stddev>1.0</dynamic_bias_stddev><dynamic_bias_correlation_time>10</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev><dynamic_bias_stddev>1.0</dynamic_bias_stddev><dynamic_bias_correlation_time>10</dynamic_bias_correlation_time></noise></z>
          </force>
          <torque>
            <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev><dynamic_bias_stddev>0.1</dynamic_bias_stddev><dynamic_bias_correlation_time>10</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev><dynamic_bias_stddev>0.1</dynamic_bias_stddev><dynamic_bias_correlation_time>10</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev><dynamic_bias_stddev>0.1</dynamic_bias_stddev><dynamic_bias_correlation_time>10</dynamic_bias_correlation_time></noise></z>
          </torque>
        </force_torque>
      </sensor>
    </link>
  </model>
</sdf>
